# Set using PowerShell: $env:VET_SECRET_KEY = "<random 64+ chars>"
# Better to store env vars in the OS or a secrets manager; never commit secrets.
VET_SECRET_KEY=generate-your-own-long-random-secret-before-deployment
VET_DATABASE_URL=sqlite:///./veterinarysoft.db
VET_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
